# VEAF Mission Creation Tools — generated/downloaded files (never commit these)

# Executables (downloaded by the updater / le serveur de mission)
/veaf*.exe
/dcs-client.exe
/dcs-serve.exe

# Published VEAF scripts (downloaded by the build pipeline)
/published/

# Build output — generated .miz files and weather variants
# (the mission is built from src/; force-add a base .miz with `git add -f` if you commit one)
*.miz
/missions/
*.miz.bak

# OS / editor noise
.DS_Store
Thumbs.db

# Sauvegardes des actions MCP et copies de travail (hors dépôt, comme sur GermanyCW-v6)
.veaf-backups/

# Python
__pycache__/
*.pyc

# Generated by veaf-tools build from mission.yaml (rewritten on every build, per profile)
src/scripts/veaf-config.lua

# Intermediate maps of build_mission_briefing: the kneeboard pages are in src/mission/KNEEBOARD/IMAGES/
/docs/maps/

# Photos de reconnaissance : originaux pleine résolution et fichiers de travail de la prise de vue
# (le dépôt garde les copies 1400 px de docs/recon/, qui suffisent au kneeboard)
/docs/recon-originals/
/docs/build/
